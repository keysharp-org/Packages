{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packages.keysharp.org/schemas/kpm.schema.json",
  "title": "Project manifest",
  "description": "kpm.json — a consumer's dependencies, as ranges a human wrote. The exact releases a resolve settled on go in kpm.lock.json.",
  "type": "object",
  "required": ["schema"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keysharp": { "type": "string" },
        "autohotkey": { "type": "string" }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "owner/name to an npm-style SemVer range."
    }
  }
}
